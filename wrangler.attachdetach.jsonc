{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k8flare-attachdetach",
  "main": "packages/attachdetach-worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": {
    "directory": "./packages/control-plane-worker/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/wasm/*"],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "services": [
    { "binding": "APISERVER", "service": "k8flare", "entrypoint": "AttachDetachAPIServer" },
  ],
  "observability": { "enabled": true },
}
