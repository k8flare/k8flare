{
  "name": "k8flare-runtime",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-24",
  // Internal-only: all traffic arrives via the gateway's service binding
  // (CLAUDE.md: gateway is the only public Worker).
  "workers_dev": false,
  "durable_objects": {
    "bindings": [{ "name": "CLUSTER", "class_name": "Cluster", "script_name": "k8flare-storage" }],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
