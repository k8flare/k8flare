{
  "name": "k8flare-controllers",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-24",
  "durable_objects": {
    "bindings": [
      { "name": "CONTROLLERS", "class_name": "Controllers" },
      { "name": "CLUSTER", "class_name": "Cluster", "script_name": "k8flare-storage" },
    ],
  },
  "services": [{ "binding": "GATEWAY", "service": "k8flare-gateway" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Controllers"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
