{
  "name": "k8flare-controllers",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-24",
  // Internal-only: poked via storage's service binding; a public URL
  // would let anyone open pump windows (CLAUDE.md: gateway is the only
  // public Worker).
  "workers_dev": false,
  // The real kube-controller-manager WASM is NOT bundled into this script
  // (it would blow Workers' 10MiB gzip deploy cap -- gzip ~13MB). It is
  // served from Static Assets in <=24MiB chunks and assembled + loaded at
  // runtime through the Worker Loader (64MiB cap, satisfied via wasm-opt;
  // see scripts/build-controllers-wasm.sh and src/index.ts).
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    // Assets here are an internal code-supply channel for the Loader
    // factory, not a website -- never serve them to inbound requests.
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONTROLLERS", "class_name": "Controllers" },
      { "name": "CLUSTER", "class_name": "Cluster", "script_name": "k8flare-storage" },
    ],
  },
  "services": [{ "binding": "GATEWAY", "service": "k8flare-gateway" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Controllers"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
