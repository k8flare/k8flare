{
  "name": "k8flare-apiserver",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-03-24",
  "durable_objects": {
    "bindings": [{ "name": "CLUSTER", "class_name": "Cluster", "script_name": "k8flare-storage" }],
  },
  // OpenAPI v2/v3 documents (generated by cmd/k8flare-gen, see openapi.go)
  // served straight from Cloudflare's asset store, without invoking this
  // Worker at all, for any request path under ./assets -- zero script-size
  // or CPU-time cost. Only the bare /openapi/v3 index can't live here (see
  // RegisterOpenAPIDiscovery, pkg/apiserver/discovery.go) and is served by
  // the Go binary instead.
  "assets": { "directory": "./assets", "binding": "ASSETS" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
