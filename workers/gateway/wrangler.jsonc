{
  "name": "k8flare-gateway",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-24",
  "durable_objects": {
    "bindings": [
      { "name": "WATCHHUB", "class_name": "WatchHub", "script_name": "k8flare-storage" },
    ],
  },
  "services": [
    { "binding": "APISERVER", "service": "k8flare-apiserver" },
    { "binding": "RUNTIME", "service": "k8flare-runtime" },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
