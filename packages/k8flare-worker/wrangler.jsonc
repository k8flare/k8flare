{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The ONE deployed Worker (S19 consolidation): absorbs the former
  // k8flare-{gateway,apiserver,storage,runtime,controllers,nodes} split.
  // The Go apiserver and KCM binaries are NOT bundled here -- they ship
  // as Static Assets chunks under ./assets/wasm/ and run as Loader
  // dynamic workers (S14/S19), keeping this script's deploy size tiny.
  "name": "k8flare",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-01",
  // /wasm/* (the KCM + apiserver chunk supply channel) must go through
  // the Worker (which 404s it publicly); so must /openapi/v2*, which is
  // the one asset needing content negotiation (JSON vs the protobuf
  // encoding client-go demands -- gateway/index.ts serveOpenAPIV2). Every
  // other asset -- the OpenAPI/discovery documents under api/, apis/,
  // openapi/v3/ -- keeps being served straight from the asset store for
  // the default cluster, exactly like the pre-consolidation apiserver
  // Worker did. /c/<id>/ prefixed requests never match an asset path and
  // reach the Worker, which strips the prefix and forwards to ASSETS itself.
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/wasm/*", "/openapi/v2*"],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "CLUSTER", "class_name": "Cluster" },
      { "name": "WATCHHUB", "class_name": "WatchHub" },
      { "name": "CONTROLLERS", "class_name": "Controllers" },
      { "name": "REGISTRY", "class_name": "ClusterRegistry" },
      { "name": "SCHEDULER", "class_name": "CFContainersScheduler" },
      { "name": "NODE_VM_SMALL", "class_name": "NodeVMSmall" },
      { "name": "NODE_VM_MEDIUM", "class_name": "NodeVMMedium" },
      { "name": "NODE_VM_LARGE", "class_name": "NodeVMLarge" },
    ],
  },
  "containers": [
    {
      "class_name": "NodeVMSmall",
      "image": "./images/node/Dockerfile",
      "instance_type": "lite",
      "max_instances": 20,
      // To SSH into a NodeVM for debugging, add your own key here:
      //   "authorized_keys": [{ "name": "you", "public_key": "ssh-ed25519 AAAA..." }],
    },
    {
      "class_name": "NodeVMMedium",
      "image": "./images/node/Dockerfile",
      "instance_type": "basic",
      "max_instances": 20,
      // To SSH into a NodeVM for debugging, add your own key here:
      //   "authorized_keys": [{ "name": "you", "public_key": "ssh-ed25519 AAAA..." }],
    },
    {
      "class_name": "NodeVMLarge",
      "image": "./images/node/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10,
      // To SSH into a NodeVM for debugging, add your own key here:
      //   "authorized_keys": [{ "name": "you", "public_key": "ssh-ed25519 AAAA..." }],
    },
  ],
  "services": [
    // Self bindings (S19 G2). SELF: the public fetch handler, handed to
    // the KCM dynamic worker as its "GATEWAY". STORAGE: the
    // ClusterLoopback named entrypoint, handed to the apiserver dynamic
    // worker as its route to the Cluster DO (DO namespaces cannot cross
    // the Loader env clone, S2 item 3a).
    { "binding": "SELF", "service": "k8flare" },
    { "binding": "STORAGE", "service": "k8flare", "entrypoint": "ClusterLoopback" },
  ],
  "vars": {
    // DEPLOYMENT-SPECIFIC -- change this before you deploy. It is the public
    // URL in-VM k3s agents dial from outside (service bindings don't reach
    // into microVMs, see src/nodes) and the origin baked into every
    // kubeconfig the cluster operator mints: a request arriving over the
    // GATEWAY service binding carries a synthetic host, so this cannot be
    // derived from the request. Pointing it at someone else's deployment
    // makes your nodes join THEIR control plane.
    // Either edit it here or override at deploy time:
    //   wrangler deploy -c packages/k8flare-worker/wrangler.jsonc \
    //     --var GATEWAY_URL:https://<your-worker>.<your-subdomain>.workers.dev
    "GATEWAY_URL": "https://k8flare.example.workers.dev",
  },
  // Cloudflare Mesh (spikes/s17-mesh-nodevm/FINDINGS.md): reaches any
  // BYO VM node joined to the account-wide Mesh directly at its Mesh IP
  // -- no per-node Tunnel/VPC Service resource, unlike the legacy
  // KUBELET_VPC path (infra/setup-tunnel.sh, still supported as a
  // fallback -- see gateway/proxy/target.ts). "cf1:network" is a fixed
  // literal meaning "this account's Mesh", not a per-node identifier.
  // remote:true makes plain `wrangler dev` proxy this one binding to
  // the real Mesh network (VPC/Mesh bindings have no local emulation).
  "vpc_networks": [{ "binding": "MESH", "network_id": "cf1:network", "remote": true }],
  // Migration history must match what production has already applied:
  // the "k8flare" Worker name predates the 6-Worker split (the original
  // packages/worker deploy) and sits at tag v1 = [Etcd]. v2 is the
  // consolidation cutover: drop Etcd (old DO state discarded,
  // user-approved 2026-07-06) and create today's classes. Fresh local
  // state replays v1+v2 in order, which nets out to the same result.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Etcd"] },
    {
      "tag": "v2",
      "deleted_classes": ["Etcd"],
      "new_sqlite_classes": [
        "Cluster",
        "WatchHub",
        "Controllers",
        "ClusterRegistry",
        "CFContainersScheduler",
        "NodeVMSmall",
        "NodeVMMedium",
        "NodeVMLarge",
      ],
    },
    {
      "tag": "v3",
      "deleted_classes": [
        "Cluster",
        "WatchHub",
        "Controllers",
        "ClusterRegistry",
        "CFContainersScheduler",
        "NodeVMSmall",
        "NodeVMMedium",
        "NodeVMLarge",
      ],
    },
    {
      // 2026-07-21: pre-production data wipe (user-approved). v3+v4 in one
      // deploy deletes every DO's storage (all k8s state, CA vault,
      // registry) and recreates the same classes empty.
      "tag": "v4",
      "new_sqlite_classes": [
        "Cluster",
        "WatchHub",
        "Controllers",
        "ClusterRegistry",
        "CFContainersScheduler",
        "NodeVMSmall",
        "NodeVMMedium",
        "NodeVMLarge",
      ],
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
