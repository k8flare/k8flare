{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": {
      "@k8flare/etcd": ["../etcd/src"],
      "@k8flare/k8s": ["../k8s/src"],
      "@k8flare/crd": ["../crd/src"],
      "@k8flare/dynamic-worker": ["../dynamic-worker/src"],
      "@k8flare/worker-trigger": ["../worker-trigger/src"],
      "@k8flare/proxy": ["../proxy/src"],
      "#go-worker": ["./src/go-worker.d.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../etcd" },
    { "path": "../k8s" },
    { "path": "../crd" },
    { "path": "../dynamic-worker" },
    { "path": "../worker-trigger" },
    { "path": "../proxy" }
  ]
}
