{
  "name": "k8flare",
  "main": "./src/index.ts",
  "compatibility_date": "2026-03-24",
  "durable_objects": {
    "bindings": [{ "name": "ETCD", "class_name": "Etcd" }],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Etcd"] }],
}
