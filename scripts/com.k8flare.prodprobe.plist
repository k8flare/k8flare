<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  scripts/com.k8flare.prodprobe.plist is a TEMPLATE. `make probe-install`
  substitutes this checkout's path, a PATH that reaches go, and the log
  directory, then loads the result. Copying the template by hand instead
  yields an agent launchd accepts and that can never run -- which is what it
  did between 2026-09-12 and 2026-09-13.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.k8flare.prodprobe</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__K8FLARE_CHECKOUT__/scripts/prodprobe-local.sh</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__K8FLARE_CHECKOUT__</string>
  <!--
    launchd hands a job PATH=/usr/bin:/bin:/usr/sbin:/sbin and no login shell,
    so a toolchain under $HOME (mise, homebrew) is unreachable without this.
    probe-install fills it from the go on the installing shell's PATH.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__K8FLARE_PATH__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>23</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__K8FLARE_LOGDIR__/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>__K8FLARE_LOGDIR__/launchd.err</string>
</dict>
</plist>
