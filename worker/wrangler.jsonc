{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k8flare",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/wasm/*"],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "CLUSTER", "class_name": "Cluster" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cluster"] }],
  "services": [{ "binding": "STORAGE", "service": "k8flare", "entrypoint": "ClusterLoopback" }],
  "observability": { "enabled": true },
}
