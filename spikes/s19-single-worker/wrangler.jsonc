{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // S19 spike: can ONE wrangler config host everything the 6-Worker split
  // holds today -- containers[] + assets(run_worker_first) + worker_loaders
  // + sqlite DOs + self service bindings (default + named entrypoint)?
  // Gates G1/G2/G3; see FINDINGS.md.
  "name": "s19-single-worker",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-01",
  "dev": { "port": 8941 },
  "assets": { "directory": "./assets", "binding": "ASSETS", "run_worker_first": true },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "TESTDO", "class_name": "TestDO" },
      { "name": "TINYVM", "class_name": "TinyVM" }
    ]
  },
  "containers": [
    {
      "class_name": "TinyVM",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "services": [
    { "binding": "SELF", "service": "s19-single-worker" },
    { "binding": "STORAGE", "service": "s19-single-worker", "entrypoint": "ClusterLoopback" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestDO", "TinyVM"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
