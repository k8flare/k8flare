{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s3-spike-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "dev": {
    "port": 8840,
    "inspector_port": 9240
  },
  "containers": [
    {
      "class_name": "EchoContainer",
      "image": "../echo/Dockerfile",
      "max_instances": 2
    },
    {
      "class_name": "EchoContainerNoStop",
      "image": "../echo/Dockerfile",
      "max_instances": 2
    },
    {
      "class_name": "EchoContainerRestricted",
      "image": "../echo/Dockerfile",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ECHO_CONTAINER",
        "class_name": "EchoContainer"
      },
      {
        "name": "ECHO_CONTAINER_NOSTOP",
        "class_name": "EchoContainerNoStop"
      },
      {
        "name": "ECHO_CONTAINER_RESTRICTED",
        "class_name": "EchoContainerRestricted"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EchoContainer", "EchoContainerNoStop", "EchoContainerRestricted"]
    }
  ]
}
