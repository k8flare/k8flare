{
  "name": "k8flare",
  "private": true,
  "workspaces": [
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c workers/k8flare/wrangler.jsonc --persist-to .wrangler/state",
    "deploy": "bash scripts/build-nodes-agent.sh && wrangler deploy --config workers/k8flare/wrangler.jsonc",
    "check": "vp check",
    "test": "vitest",
    "build:wasm": "bash scripts/build-wasm-chunks.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260317.1",
    "typescript": "^6.0.2",
    "vite-plus": "^0.1.14",
    "wrangler": "^4.106.0"
  },
  "packageManager": "pnpm@10.33.0"
}
