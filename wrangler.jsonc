{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k8flare",
  "main": "packages/control-plane-worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./packages/control-plane-worker/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/wasm/*"],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "CLUSTER", "class_name": "Cluster" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cluster"] }],
  "services": [
    { "binding": "PRINTERS", "service": "k8flare", "entrypoint": "Printers" },
    { "binding": "OPENAPI", "service": "k8flare", "entrypoint": "OpenAPI" },
  ],
  "observability": { "enabled": true },
}
