{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k8flare",
  "main": "packages/control-plane-worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./packages/control-plane-worker/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/wasm/*"],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [
      { "name": "CLUSTER", "class_name": "Cluster" },
      { "name": "NODE_TUNNEL", "class_name": "NodeTunnel" },
      { "name": "WAKE", "class_name": "Wake" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Cluster"] },
    { "tag": "v2", "new_sqlite_classes": ["NodeTunnel"] },
    { "tag": "v3", "new_sqlite_classes": ["Wake"] },
  ],
  "services": [
    { "binding": "PRINTERS", "service": "k8flare", "entrypoint": "Printers" },
    { "binding": "OPENAPI", "service": "k8flare", "entrypoint": "OpenAPI" },
    { "binding": "CUSTOMRESOURCES", "service": "k8flare", "entrypoint": "CustomResources" },
    { "binding": "APIGROUPS", "service": "k8flare", "entrypoint": "APIGroups" },
    { "binding": "SCHEDULER", "service": "k8flare", "entrypoint": "Scheduler" },
    { "binding": "CONTROLLERS", "service": "k8flare", "entrypoint": "Controllers" },
    { "binding": "TUNNEL", "service": "k8flare", "entrypoint": "NodeTunnels" },
    { "binding": "APISERVER", "service": "k8flare" },
  ],
  "observability": { "enabled": true },
}
