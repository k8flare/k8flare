{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "k8flare",
  "main": "packages/control-plane-worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["new_module_registry"],
  "workers_dev": true,
  "routes": [{ "pattern": "k8flare.kooffice.jp", "custom_domain": true }],
  "assets": {
    "directory": "./packages/control-plane-worker/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/wasm/*"],
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "version_metadata": { "binding": "CF_VERSION" },
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "triggers": { "crons": [] },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "kooffice",
    "ACCESS_AUD": "f5b5bb1f97c02d095ecd20352a1e2282ddef9fca76a977800783a80172cc511e",
    "ACCESS_GROUPS_CLAIM": "groups",
    "ACCESS_GROUPS_PREFIX": "access:",
    "OIDC_ISSUER_URL": "",
    "OIDC_CLIENT_ID": "",
    "OIDC_USERNAME_CLAIM": "",
    "OIDC_USERNAME_PREFIX": "",
    "OIDC_GROUPS_CLAIM": "",
    "OIDC_GROUPS_PREFIX": "",
    "OIDC_REQUIRED_CLAIMS": "",
    "MAX_REQUESTS_INFLIGHT": "400",
    "MAX_MUTATING_REQUESTS_INFLIGHT": "200",
    "CLUSTER_UID": "",
    "DISABLE": "",
    "GATEWAY_URL": "https://api.k8flare.com",
    "R2_ACCOUNT_ID": "ed17c5c18eb6052e70234ec181709fba",
    "R2_BUCKET": "k8flare-pods",
    "CLOUDFLARE_ACCOUNT_ID": "ed17c5c18eb6052e70234ec181709fba",
  },
  "r2_buckets": [{ "binding": "PODS_R2", "bucket_name": "k8flare-pods" }],
  "durable_objects": {
    "bindings": [
      { "name": "CLUSTER", "class_name": "Cluster" },
      { "name": "NODE_TUNNEL", "class_name": "NodeTunnel" },
      { "name": "NODE_SCHED", "class_name": "CFContainersScheduler" },
      { "name": "NODE_VM_SMALL", "class_name": "NodeVMSmall" },
      { "name": "NODE_VM_MEDIUM", "class_name": "NodeVMMedium" },
      { "name": "NODE_VM_LARGE", "class_name": "NodeVMLarge" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Cluster"] },
    { "tag": "v2", "new_sqlite_classes": ["NodeTunnel"] },
    { "tag": "v3", "new_sqlite_classes": ["Wake"] },
    { "tag": "v4", "deleted_classes": ["Wake"] },
    { "tag": "v5", "new_sqlite_classes": ["CFContainersScheduler"] },
    { "tag": "v6", "new_sqlite_classes": ["NodeVMSmall", "NodeVMMedium", "NodeVMLarge"] },
  ],
  "containers": [
    { "class_name": "NodeVMSmall", "image": "./packages/control-plane-worker/images/node/Dockerfile", "instance_type": "standard-2", "max_instances": 3 },
    { "class_name": "NodeVMMedium", "image": "./packages/control-plane-worker/images/node/Dockerfile", "instance_type": "standard-3", "max_instances": 2 },
    { "class_name": "NodeVMLarge", "image": "./packages/control-plane-worker/images/node/Dockerfile", "instance_type": "standard-4", "max_instances": 1 },
  ],
  "services": [
    { "binding": "PRINTERS", "service": "k8flare", "entrypoint": "Printers" },
    { "binding": "OPENAPI", "service": "k8flare", "entrypoint": "OpenAPI" },
    { "binding": "CUSTOMRESOURCES", "service": "k8flare", "entrypoint": "CustomResources" },
    { "binding": "APIGROUPS", "service": "k8flare", "entrypoint": "APIGroups" },
    { "binding": "SCHEDULER", "service": "k8flare", "entrypoint": "Scheduler" },
    { "binding": "WORKLOADS", "service": "k8flare", "entrypoint": "Workloads" },
    { "binding": "ATTACHDETACH", "service": "k8flare", "entrypoint": "AttachDetach" },
    { "binding": "GC", "service": "k8flare", "entrypoint": "GarbageCollector" },
    { "binding": "STORAGE_SVC", "service": "k8flare", "entrypoint": "Storage" },
    { "binding": "TUNNEL", "service": "k8flare", "entrypoint": "NodeTunnels" },
    { "binding": "ADMISSION", "service": "k8flare", "entrypoint": "Admission" },
    { "binding": "HOOKS", "service": "k8flare", "entrypoint": "Hooks" },
    { "binding": "OUTBOUND", "service": "k8flare", "entrypoint": "Outbound" },
    { "binding": "METRICS", "service": "k8flare", "entrypoint": "Metrics" },
    { "binding": "APISERVER", "service": "k8flare" },
  ],
  "queues": {
    "producers": [
      { "binding": "CTRL_Q", "queue": "k8flare-controllers" },
      { "binding": "SCHED_Q", "queue": "k8flare-scheduler" },
      { "binding": "WL_Q", "queue": "k8flare-workloads" },
      { "binding": "CRD_Q", "queue": "k8flare-crds" },
      { "binding": "GC_Q", "queue": "k8flare-gc" },
      { "binding": "ACCT_Q", "queue": "k8flare-accounts" },
      { "binding": "EXT_Q", "queue": "k8flare-extensions" },
      { "binding": "METRICS_Q", "queue": "k8flare-metrics" },
      { "binding": "CONTAINERS_Q", "queue": "k8flare-containers" },
      { "binding": "AD_Q", "queue": "k8flare-attachdetach" },
      { "binding": "ADDON_Q", "queue": "k8flare-addons" },
      { "binding": "HPA_Q", "queue": "k8flare-hpa" },
    ],
    "consumers": [
      { "queue": "k8flare-controllers", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-scheduler", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-workloads", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-crds", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-gc", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-accounts", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-extensions", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-metrics", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-containers", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-attachdetach", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
      { "queue": "k8flare-addons", "max_batch_size": 100, "max_batch_timeout": 1, "max_retries": 10, "max_concurrency": 1, "dead_letter_queue": "k8flare-dlq" },
    ],
  },
  "observability": { "enabled": true },
}
